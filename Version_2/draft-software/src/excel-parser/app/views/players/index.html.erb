#upload the excel file to parse (should onlt accept xlsx)
<h1>Excel Player Parser</h1>
<% if notice.present? %>
  <p role="status"><%= notice %></p>
<% end %>

<% if alert.present? %>
  <p role="alert"><%= alert %></p>
<% end %>
<h2>Upload Excel File</h2>
<%= form_with url: import_players_path, multipart: true do |form| %>
  <%= form.file_field :file, accept: ".xlsx" %>
  <%= form.submit "Upload Player Excel File (xlsx)" %>

<% end %>

<hr>

#user input to search for specific id
<h2>Search for a Player</h2>
<%= form_with url: players_path,
  method: :get do |form| %>
  <%= form.label :search, "Enter User ID:" %>
  <%= form.text_field :search %>
  <%= form.submit "Search" %>

<% end %>

<hr>

<h2>Players Results</h2>
<% if @players.any? %>
    <% @players.each do |player| %>
        <p>
            <strong>Player ID:</strong> <%= player.player_id %><br>
            <strong>Player Name:</strong> <%= player.name %><br>
            <strong>Salary:</strong> <%= player.salary || "N/A" %><br>
        </p>
    <% end %>
<% else %>
    <p>No players found.</p>
<% end %>
